# Panda's settings: copy this file to panda.env, fill in the token and run
#   panda --config panda.env
# Never share or commit the filled-in file: ERA_BOT_TOKEN is the bot's password.

# Evre's address.
ERA_URL=https://evre.chat
# Server settings -> Bots -> Create bot (shown once; "Reset token" there if lost).
ERA_BOT_TOKEN=erabot_REPLACE_ME

# Language of Panda's replies and panel: tr, en, fr, de or es (default tr).
# The commands work in every language at once (!play, !jouer, !çal, ...).
PANDA_LANG=en

# Optional. The defaults are shown.
# PANDA_PREFIX=!
# PANDA_DATA_DIR=panda-data
# Full paths if yt-dlp / ffmpeg are not on the PATH (ffprobe must sit next to ffmpeg):
# PANDA_YTDLP=yt-dlp
# PANDA_FFMPEG=ffmpeg
# Run "yt-dlp -U" at start and once a day (only for yt-dlp's own release binary):
# PANDA_YTDLP_AUTO_UPDATE=false
# Cookies file (Netscape format) for YouTube's "Sign in to confirm you're not a bot":
# PANDA_YTDLP_COOKIES=cookies.txt
# PANDA_VOLUME=100
# PANDA_LOUDNORM=true
# Music bitrate in kbit/s; the server caps it at your plan's bot music quality.
# PANDA_BITRATE_KBPS=
# PANDA_ALONE_MINUTES=2
# PANDA_IDLE_MINUTES=5
# PANDA_MAX_QUEUE=200
